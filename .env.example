# Which model powers the agents: offline | azure | foundry_local | github | openai
PITCHSIDE_LLM=offline
PITCHSIDE_SEED=4

# Azure OpenAI / Azure AI Foundry
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=

# Foundry Local (on-device): `foundry model run phi-4-mini`, then copy the endpoint it prints
FOUNDRY_LOCAL_ENDPOINT=http://localhost:5273/v1
FOUNDRY_LOCAL_MODEL=phi-4-mini

# Azure AI Speech (optional neural TTS for read-aloud)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure Event Hubs (optional transport for the live feed)
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAME=match-events
